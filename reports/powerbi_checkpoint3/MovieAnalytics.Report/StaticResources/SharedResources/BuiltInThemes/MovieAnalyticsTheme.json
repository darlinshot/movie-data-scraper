{
  "name": "MovieAnalyticsTheme",
  "dataColors": [
    "#2F5597",
    "#ED7D31",
    "#70AD47",
    "#5B9BD5",
    "#A5A5A5",
    "#FFC000",
    "#4472C4",
    "#C00000",
    "#264478",
    "#9E480E"
  ],
  "background": "#FFFFFF",
  "foreground": "#1F2937",
  "foregroundNeutralSecondary": "#4B5563",
  "foregroundNeutralTertiary": "#9CA3AF",
  "backgroundLight": "#F3F4F6",
  "backgroundNeutral": "#D1D5DB",
  "tableAccent": "#2F5597",
  "good": "#70AD47",
  "neutral": "#FFC000",
  "bad": "#C00000",
  "maximum": "#2F5597",
  "center": "#FFC000",
  "minimum": "#DEEAF6",
  "null": "#ED7D31",
  "hyperlink": "#0563C1",
  "visitedHyperlink": "#954F72",
  "textClasses": {
    "callout": { "fontSize": 42, "fontFace": "Segoe UI Semibold", "color": "#1F2937" },
    "title": { "fontSize": 20, "fontFace": "Segoe UI Semibold", "color": "#1F2937" },
    "header": { "fontSize": 13, "fontFace": "Segoe UI Semibold", "color": "#1F2937" },
    "label": { "fontSize": 10, "fontFace": "Segoe UI", "color": "#1F2937" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#FFFFFF" } },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#E5E7EB" } },
            "radius": 4
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": { "solid": { "color": "#1F2937" } },
            "fontSize": 11
          }
        ]
      }
    }
  }
}
